<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.praetorx_ai_providers</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="ai.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//setting[@id='google_provider']" position="after">
                <setting id="praetorx_ai_endpoints" string="Own AI providers"
                         help="Anthropic Claude, Ollama, vLLM, OpenRouter, Azure — with your keys. Mark one endpoint as default and Odoo's AI features use it."
                         groups="base.group_system">
                    <div class="mt-2">
                        <button name="action_open_ai_endpoints" type="object" string="Manage endpoints" class="btn-link" icon="oi-arrow-right"/>
                    </div>
                </setting>
                <setting id="praetorx_ai_models" string="Model per task"
                         help="Cheap models for cheap tasks: which model chooses from a list, which reads files, which embeds."
                         groups="base.group_system">
                    <div class="row mt-2">
                        <label for="ai_model_choose_id" class="col-lg-4 o_light_label"/>
                        <field name="ai_model_choose_id" class="col-lg-8"/>
                    </div>
                    <div class="row">
                        <label for="ai_model_read_id" class="col-lg-4 o_light_label"/>
                        <field name="ai_model_read_id" class="col-lg-8"/>
                    </div>
                    <div class="row">
                        <label for="ai_model_embed_id" class="col-lg-4 o_light_label"/>
                        <field name="ai_model_embed_id" class="col-lg-8"/>
                    </div>
                </setting>
                <setting id="praetorx_ai_budget" string="Monthly AI budget"
                         help="Per company. Soft limit notifies the administrator, hard limit refuses further requests until next month."
                         groups="base.group_system">
                    <div class="row mt-2">
                        <label for="ai_budget_soft" class="col-lg-4 o_light_label"/>
                        <field name="ai_budget_soft" class="col-lg-8"/>
                    </div>
                    <div class="row">
                        <label for="ai_budget_hard" class="col-lg-4 o_light_label"/>
                        <field name="ai_budget_hard" class="col-lg-8"/>
                    </div>
                    <div class="row">
                        <label for="ai_month_cost" class="col-lg-4 o_light_label"/>
                        <field name="ai_month_cost" class="col-lg-8"/>
                    </div>
                    <div class="mt-2">
                        <button name="action_open_ai_usage" type="object" string="Usage report" class="btn-link" icon="oi-arrow-right"/>
                    </div>
                </setting>
            </xpath>
        </field>
    </record>
</odoo>
