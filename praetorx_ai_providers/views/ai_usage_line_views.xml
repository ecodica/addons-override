<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_ai_usage_line_list" model="ir.ui.view">
        <field name="name">ai.usage.line.list</field>
        <field name="model">ai.usage.line</field>
        <field name="arch" type="xml">
            <list create="0" edit="0">
                <field name="create_date"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="endpoint_code"/>
                <field name="model_name"/>
                <field name="caller"/>
                <field name="input_tokens" sum="Input"/>
                <field name="cached_tokens" sum="Cached"/>
                <field name="output_tokens" sum="Output"/>
                <field name="cost" sum="Cost"/>
                <field name="currency_id" column_invisible="1"/>
            </list>
        </field>
    </record>

    <record id="view_ai_usage_line_pivot" model="ir.ui.view">
        <field name="name">ai.usage.line.pivot</field>
        <field name="model">ai.usage.line</field>
        <field name="arch" type="xml">
            <pivot>
                <field name="caller" type="row"/>
                <field name="create_date" interval="month" type="col"/>
                <field name="cost" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="view_ai_usage_line_graph" model="ir.ui.view">
        <field name="name">ai.usage.line.graph</field>
        <field name="model">ai.usage.line</field>
        <field name="arch" type="xml">
            <graph type="bar" stacked="True">
                <field name="create_date" interval="month"/>
                <field name="caller"/>
                <field name="cost" type="measure"/>
            </graph>
        </field>
    </record>

    <record id="view_ai_usage_line_search" model="ir.ui.view">
        <field name="name">ai.usage.line.search</field>
        <field name="model">ai.usage.line</field>
        <field name="arch" type="xml">
            <search>
                <field name="caller"/>
                <field name="model_name"/>
                <field name="endpoint_code"/>
                <filter name="this_month" string="This month"
                        domain="[('create_date', '>=', (context_today() + relativedelta(day=1)).strftime('%Y-%m-%d'))]"/>
                <group>
                    <filter name="group_caller" string="Caller" context="{'group_by': 'caller'}"/>
                    <filter name="group_model" string="Model" context="{'group_by': 'model_name'}"/>
                    <filter name="group_month" string="Month" context="{'group_by': 'create_date:month'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_ai_usage_line" model="ir.actions.act_window">
        <field name="name">AI Usage</field>
        <field name="res_model">ai.usage.line</field>
        <field name="view_mode">pivot,graph,list</field>
        <field name="context">{'search_default_this_month': 1, 'search_default_group_caller': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No AI usage recorded yet</p>
            <p>Every request through a configured endpoint writes a line with tokens and cost.</p>
        </field>
    </record>
</odoo>
